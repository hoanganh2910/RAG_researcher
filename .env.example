# PostgreSQL Configuration
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/rag_researcher

# Elasticsearch Configuration
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=rag_researcher_chunks

# Ollama / Local LLM & Embeddings
OLLAMA_URL=http://localhost:11434
OLLAMA_KEEP_ALIVE=5m

# Redis Cache
REDIS_URL=redis://localhost:6379/0
RAG_CACHE_TTL_SECONDS=86400

# Langfuse Observability
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# Embedding Configuration
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# Reranking Configuration
RERANKER_MODEL=BAAI/bge-reranker-base
RERANK_ENABLED=true

# Query Expansion / HyDE
HYDE_ENABLED=true

# DeepSeek / Cloud LLM API Key (if used)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# Retrieval & Pipeline Settings
RETRIEVAL_CANDIDATE_MULTIPLIER=4
RETRIEVAL_RRF_K=60
PIPELINE_RETRY_ATTEMPTS=3
PIPELINE_RETRY_BACKOFF_SECONDS=2.0
PIPELINE_SCHEDULE_INTERVAL_MINUTES=60
PIPELINE_SCHEDULE_CRON=

# Evaluation Settings
EVALUATION_OUTPUT_DIR=reports/evaluation

# Agent Decision & Policies
AGENT_DECISION_MODEL=llama3.2
AGENT_DECISION_ENABLED=true
AGENT_DECISION_TIMEOUT=15.0

# Agentic Chunking Settings
AGENTIC_CHUNK_ENABLED=true
AGENTIC_CHUNK_PROVIDER=ollama
AGENTIC_CHUNK_MODEL=llama3.2
AGENTIC_CHUNK_MAX_TOKENS=800
AGENTIC_CHUNK_EMBED_LOW_VALUE=false
AGENTIC_CHUNK_MIN_TOKENS=50
AGENTIC_CHUNK_TARGET_TOKENS=400
AGENTIC_CHUNK_MAX_CHUNKS_PER_SECTION=8

# Logging Settings
LOG_LEVEL=INFO
LOG_FORMAT=console
